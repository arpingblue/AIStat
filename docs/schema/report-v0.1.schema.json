{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aistat.dev/schema/report-v0.1.schema.json",
  "title": "AIStat v0.1 report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "aistat_version", "collected_at", "profile", "compatibility_version", "readiness", "summary", "node", "findings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "aistat_version": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "profile": {"enum": ["general", "llm-inference"]},
    "compatibility_version": {"type": "string", "minLength": 1},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "performance"],
      "properties": {
        "deployment": {"enum": ["ready", "not_ready", "unknown"]},
        "performance": {"enum": ["ready", "warn", "unknown"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "info", "unknown", "skip"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0}
      }
    },
    "node": {
      "type": "object",
      "required": ["meta", "host", "cpu", "memory", "numa", "pci", "gpus", "network", "rdma", "storage", "nvidia", "containers", "processes", "runtimes"],
      "properties": {
        "meta": {"type": "object"},
		"host": {"$ref": "#/$defs/stateSection"},
        "cpu": {"$ref": "#/$defs/stateSection"},
        "memory": {"$ref": "#/$defs/stateSection"},
        "numa": {"$ref": "#/$defs/stateSection"},
        "pci": {"$ref": "#/$defs/stateSection"},
        "gpus": {"$ref": "#/$defs/stateSection"},
        "network": {"$ref": "#/$defs/stateSection"},
        "rdma": {"$ref": "#/$defs/stateSection"},
        "storage": {"$ref": "#/$defs/stateSection"},
        "nvidia": {"$ref": "#/$defs/stateSection"},
        "containers": {"$ref": "#/$defs/containerState"},
        "processes": {"$ref": "#/$defs/stateSection"},
        "runtimes": {"$ref": "#/$defs/runtimeState"},
		"p2p": {"type": "array"},
		"topology": {"type": "array"},
        "collectors": {"type": "array"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "title", "domain", "status", "severity", "dimension", "priority", "subject", "current_state", "why", "recommendation", "confidence", "evidence", "verification", "references"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Z]+[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "warn", "fail", "info", "unknown", "skip"]},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "dimension": {"enum": ["deployment", "performance"]},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "subject": {"type": "object"},
          "current_state": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {"type": "array"},
          "verification": {"type": "array"},
          "references": {"type": "array"}
        }
      }
    }
  },
  "$defs": {
	"factState": {
	  "enum": ["available", "not_detected", "unsupported", "permission_denied", "timeout", "parse_error", "unknown"]
	},
    "stateSection": {
      "type": "object",
      "required": ["state"],
      "properties": {
		"state": {"$ref": "#/$defs/factState"}
      }
	},
	"containerState": {
	  "type": "object",
	  "required": ["state", "daemon_state"],
	  "properties": {
		"state": {"$ref": "#/$defs/factState"},
		"client_state": {"$ref": "#/$defs/factState"},
		"daemon_state": {"$ref": "#/$defs/factState"},
		"nvidia_runtime_state": {"$ref": "#/$defs/factState"},
		"toolkit_state": {"$ref": "#/$defs/factState"},
		"toolkit_package_state": {"$ref": "#/$defs/factState"},
		"toolkit_cli_state": {"$ref": "#/$defs/factState"},
		"cdi_state": {"$ref": "#/$defs/factState"},
		"gpu_container_state": {"$ref": "#/$defs/factState"},
		"toolkit_packages": {"type": "array", "items": {"type": "string"}},
		"cdi_specs": {"type": "array", "items": {"type": "string"}},
		"gpu_container_modes": {"type": "array", "items": {"type": "string"}},
		"toolkit_evidence": {"type": "array", "items": {"type": "string"}}
	  }
	},
	"runtimeState": {
	  "type": "object",
	  "required": ["state"],
	  "properties": {
		"state": {"$ref": "#/$defs/factState"},
		"instances": {"type": "array", "items": {"type": "object"}},
		"products": {"type": "array", "items": {"$ref": "#/$defs/runtimeProduct"}}
	  }
	},
	"runtimeProduct": {
	  "type": "object",
	  "required": ["name", "installation_state", "execution_state", "host_state", "container_state", "instance_count"],
	  "properties": {
		"name": {"enum": ["pytorch", "vllm", "sglang"]},
		"installation_state": {"$ref": "#/$defs/factState"},
		"installation_reason": {"type": "string"},
		"execution_state": {"$ref": "#/$defs/factState"},
		"execution_reason": {"type": "string"},
		"host_state": {"$ref": "#/$defs/factState"},
		"container_state": {"$ref": "#/$defs/factState"},
		"instance_count": {"type": "integer", "minimum": 0},
		"installations": {"type": "array", "items": {"$ref": "#/$defs/runtimeInstallation"}}
	  }
	},
	"runtimeInstallation": {
	  "type": "object",
	  "required": ["product", "path", "scope", "source", "confidence"],
	  "properties": {
		"product": {"enum": ["pytorch", "vllm", "sglang"]},
		"version": {"type": "string"},
		"path": {"type": "string", "minLength": 1},
		"python_environment": {"type": "string"},
		"scope": {"enum": ["host", "container"]},
		"container_id": {"type": "string"},
		"source": {"type": "string", "minLength": 1},
		"confidence": {"enum": ["high", "medium", "low"]}
	  }
	}
  }
}
